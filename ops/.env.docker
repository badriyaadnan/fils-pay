# Local docker-compose settings — development only. Never use in production.
# إعدادات التشغيل المحلي فقط. لا تستخدمينها في الإنتاج أبداً.
#
# Fix: compose never loaded this file (no env_file:), so the API crashed at
# boot because required settings were missing. It is now loaded by
# docker-compose.yml. This file is committed to git, so no real secrets here.
# الإصلاح: هذا الملف ما كان ينقرا أصلاً، فالـ API كان يطيح عند التشغيل لأن
# إعدادات مطلوبة ناقصة. الحين docker-compose.yml يقراه. والملف مرفوع على git،
# فما نحط فيه أسرار حقيقية.

# development = cookies work on http://localhost and the OTP code is shown
# in the login response, so we can test locally.
# development = الكوكيز تشتغل على localhost ورمز OTP يطلع في الرد عشان نجرب.
NODE_ENV=development
PORT=3000

# Shared token between the API and the settlement service (local value).
# رمز مشترك بين الـ API وخدمة التسويات (قيمة محلية).
SETTLEMENT_INTERNAL_TOKEN=local-dev-internal-token

# 32 random bytes in base64, used to encrypt webhook secrets (local only).
# مفتاح تشفير أسرار الـ webhooks (للتشغيل المحلي بس).
WEBHOOK_SECRET_ENCRYPTION_KEY=a1Jhz2fIES2uCBInQJOXkca3wBclVttKxp4D7yY7bgY=

# The old acquirer secret was committed to git, so treat it as leaked.
# السر القديم انرفع على git، فنعتبره مكشوف ونستخدم قيمة محلية.
ACQUIRER_CALLBACK_SIGNING_SECRET=local-dev-acquirer-callback-secret
ACQUIRER_CALLBACK_REQUIRE_SIGNATURE=true